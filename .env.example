# Kopier til .env.local og fyll inn. .env.local er gitignorert.
#
# Verdiene under er satt opp for den enkleste veien: lokal database i Docker og
# lagrede modellsvar, altså ingen nøkler og ingen betalte kontoer. Se README for
# oppstart. Vil du kjøre mot ekte modellkall eller mot Neon, bytt ut de to
# aktuelle variablene som beskrevet i hver bolk.


# --- Database -----------------------------------------------------------------
#
# Verdien under peker på den lokale databasen i docker-compose.yml. Den virker
# som den står, etter `npm run db:opp`.
#
# Mot prosjektets Neon-instans i stedet: kjør `npx vercel env pull .env.local`.
# Da settes DATABASE_URL og DATABASE_URL_UNPOOLED av Vercel, og data/db.ts
# bytter driver av seg selv ut fra vertsnavnet.

DATABASE_URL=postgres://lesevenn:lesevenn@localhost:5432/lesevenn


# --- Språkmodell --------------------------------------------------------------
#
# LESEVENN_TESTMODUS styrer om modellen kalles:
#
#   les     svarene leses fra testdata/modellsvar/. Ingen nøkkel trengs, og
#           ingenting koster penger. Dekker eksempelteksten i repoet.
#   av      modellen kalles. Krever ANTHROPIC_API_KEY under.
#   skriv   modellen kalles, og svaret lagres til testdata/modellsvar/.
#           Slik lages filene testmodus leser.

LESEVENN_TESTMODUS=les

# Trengs bare med LESEVENN_TESTMODUS=av eller =skriv.
ANTHROPIC_API_KEY=


# --- Innlogging ---------------------------------------------------------------
# Legges inn når Better Auth settes opp.

# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
