# Kopier til .env.local og fyll inn. .env.local er gitignorert.
# Merk: de samme variablene maa ogsaa settes i Vercels dashboard.
# De to stedene snakker ikke sammen, og aa glemme det andre gir en app
# som virker lokalt og feiler i drift.

# LLM-leverandoer (start: Anthropic, sammenlign mot en annen foer M1)
ANTHROPIC_API_KEY=

# PostgreSQL
DATABASE_URL=

# Better Auth (legges inn naar innlogging settes opp)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
